{
  "name": "@opengeo/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test dist/**/*.test.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@opengeo/shared": "workspace:*",
    "@opengeo/page-model": "workspace:*",
    "@opengeo/rule-engine": "workspace:*",
    "@opengeo/crawler": "workspace:*",
    "@opengeo/schema-analyzer": "workspace:*",
    "@opengeo/entity-analyzer": "workspace:*",
    "@opengeo/content-analyzer": "workspace:*",
    "@opengeo/crawler-policy": "workspace:*",
    "@opengeo/patch-generator": "workspace:*",
    "@opengeo/scoring": "workspace:*",
    "@opengeo/reporting": "workspace:*",
    "@opengeo/llm-provider": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
