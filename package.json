{
  "name": "opengeo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source evidence-backed AI Search Readiness Auditor",
  "author": "DjimIT",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/DjimIT/opengeo"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "eslint .",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.29",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "nanoid": "^3.3.18",
      "sharp": "^0.35.5",
      "source-map-js": "^1.2.2",
      "undici": "^6.29.1"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
