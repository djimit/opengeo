{
  "name": "opengeo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source evidence-backed AI Search Readiness Auditor",
  "author": "DjimIT",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/DjimIT/opengeo"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
